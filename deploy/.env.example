# Copia este archivo como .env (en deploy/ para local, junto al compose en el droplet).
# El .env real trae credenciales: nunca lo subas a un repo.

# Puerto publico del droplet. El 80 esta ocupado por otra app del equipo.
PUERTO_PUBLICO=8084

# MySQL corre en su propio contenedor, no en el MySQL del sistema.
DB_NAME=mercaditoLibre_db
DB_USER=mercadito
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# HS256 exige 32+ caracteres. Generar:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION=86400000

# Ambas claves de la misma cuenta y el mismo modo (pk_test_ con sk_test_).
STRIPE_PUBLIC_KEY=pk_test_REEMPLAZA_ESTO
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_ESTO

# Nunca true en el droplet: marca ventas como pagadas sin cobrar.
PAGOS_SIMULADOR=false

# Debe incluir el puerto. Ej: http://143.198.1.2:8084
CORS_ORIGINS=http://IP_DEL_DROPLET:8084
