# Plantilla de variables de entorno. Copia este archivo como .env y rellena los valores.
# El .env real esta en .gitignore y no debe subirse nunca al repositorio.
#
# OJO: Spring Boot NO lee el .env por si solo. En local lo carga el "envFile" de
# .vscode/launch.json (F5). Por terminal hay que exportar las variables antes de arrancar.
# En el host se definen como variables de entorno del servicio.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mercaditoLibre_db

# Stripe. Ambas claves deben ser de la misma cuenta y el mismo modo.
# Test:  https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLIC_KEY=pk_test_REEMPLAZA_ESTO
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_ESTO

# Simulador de pagos sin cobro real. En produccion debe ser false.
PAGOS_SIMULADOR=false

# Firma de los tokens JWT. HS256 exige 32+ caracteres; usa una distinta en cada entorno.
# Generar una:  openssl rand -base64 48
# En PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION=86400000

# Origenes que pueden llamar a la API, separados por comas. Admite comodines.
# En produccion: el dominio real del frontend, p.ej. https://mi-tienda.vercel.app
CORS_ORIGINS=http://localhost:5174
